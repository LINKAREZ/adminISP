APP_NAME=AdminISP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Base de Datos (en Docker usar DB_HOST=db, DB_USERNAME=adminisp y la misma DB_PASSWORD del compose)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=adminisp
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PERSISTENT=false

# Redis (Opcional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Cache
CACHE_DRIVER=file
CACHE_PREFIX=

# Sesiones
SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_DOMAIN=null
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Mail (Opcional)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# APIs Externas - DNI/RUC (APIsPERU - soporte@apisperu.com)
# Token que te envían por email; se usa en la URL como ?token=
APISPERU_API_KEY=
APISPERU_TIMEOUT=15
APISPERU_USE_QUERY_TOKEN=true

# Seguridad - Usuarios Root/Admin por defecto (configurar en producción)
ROOT_USER_EMAIL=
ROOT_USER_PASSWORD=
ROOT_USER_NAME=Root
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Administrador

# Empresa (Comprobantes)
EMPRESA_RUC=
EMPRESA_DIRECCION=
EMPRESA_TELEFONO=
EMPRESA_EMAIL=

# Configuración ISP
ISP_EMPRESA_NOMBRE=AdminISP
ISP_EMPRESA_RUC=
ISP_EMPRESA_DIRECCION=
ISP_EMPRESA_TELEFONO=
ISP_EMPRESA_EMAIL=
ISP_EMPRESA_LOGO=/images/logo.png

# Comprobantes
ISP_MONEDA=PEN
ISP_SIMBOLO_MONEDA=S/.
ISP_IGV=18
ISP_DIA_EMISION=1
ISP_DIAS_GRACIA=5
ISP_DIAS_VENCIMIENTO=15
ISP_GENERAR_RECIBOS_AUTO=true
ISP_SERIE_BOLETA=B001
ISP_SERIE_FACTURA=F001

# Servicios
ISP_CORTE_AUTOMATICO=true
ISP_DIAS_ANTES_CORTE=0
ISP_REACTIVACION_AUTO=true
ISP_NOTIFICAR_VENCIMIENTO=true
ISP_DIAS_NOTIF_VENC=3

# MikroTik / RouterOS
MIKROTIK_API_PORT=8728
MIKROTIK_API_SSL_PORT=8729
MIKROTIK_TIMEOUT=10
MIKROTIK_USE_SSL=false
MIKROTIK_SCRIPT_PREFIX=ISP_
MIKROTIK_SCHEDULER_PREFIX=CORTE_

# RouterOS - Configuración por defecto (se puede configurar múltiples routers)
ROUTEROS_DEFAULT_HOST=192.168.1.1
ROUTEROS_DEFAULT_USER=admin
ROUTEROS_DEFAULT_PASS=

# Notificaciones
ISP_WHATSAPP_ENABLED=false
ISP_EMAIL_ENABLED=false
ISP_SMS_ENABLED=false
ISP_NOTIF_NUEVO_PAGO=true
ISP_NOTIF_CORTE=true
ISP_NOTIF_ACTIVACION=true

# WhatsApp API (si ISP_WHATSAPP_ENABLED=true)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Paginación
ISP_PAGINACION_DEFAULT=15
ISP_PAGINACION_CLIENTES=20
ISP_PAGINACION_SERVICIOS=15
ISP_PAGINACION_RECIBOS=20
ISP_PAGINACION_AUDITORIA=50

# Archivos
ISP_MAX_FILE_SIZE=5120
ISP_MAX_IMAGE_SIZE=2048
ISP_DISK_CAPTURAS=public
ISP_DISK_COMPROBANTES=public

# Mapa de ubicación: leaflet (por defecto), maplibre (open source) o google (requiere API key)
# Ver docs/MAPA_UBICACION.md
MAP_PROVIDER=leaflet
# Alternativa open source (MapLibre, sin clave):
# MAP_PROVIDER=maplibre
# Google Maps (crear clave en Google Cloud, Maps JavaScript API):
# MAP_PROVIDER=google
# GOOGLE_MAPS_API_KEY=tu_api_key_aqui
